{
  "name": "ws-pack",
  "version": "1.0.0",
  "description": "Creates self-contained deployment archives for npm workspaces.",
  "author": "cnshenj",
  "bin": {
    "ws-pack": "out/cli.js"
  },
  "files": [
    "out"
  ],
  "type": "module",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "oxlint -c oxlint.config.mts src tests",
    "format": "oxfmt -c oxfmt.config.mts src tests package.json",
    "format:check": "oxfmt -c oxfmt.config.mts --check src tests package.json",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "ws-pack": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@npmcli/map-workspaces": "^5.0.3",
    "commander": "^15.0.0",
    "npm-package-arg": "^13.0.2",
    "npm-packlist": "^10.0.4",
    "tar": "^7.5.19",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/npm-package-arg": "^6.1.4",
    "@types/npm-packlist": "^7.0.3",
    "@types/npmcli__map-workspaces": "^3.0.4",
    "@types/npmcli__package-json": "^4.0.4",
    "@types/yazl": "^3.3.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
